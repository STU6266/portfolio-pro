  - Professional profile links open in a new tab.
-->

<footer>
  <div class="footer-container">
    <div class="footer-impressum">
      <a href="/impressum">Impressum</a>

    </div>

    <p class="footer-copy">&copy; 2026 Steven Kemendics</p>

    <nav class="footer-nav" aria-label="Professional links">
      <a
        href="https://github.com/STU6266"
        target="_blank"
        rel="noopener"
        class="footer-link"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/steven-kemendics"
        target="_blank"
        rel="noopener"
        class="footer-link"
      >
        LinkedIn
      </a>
    </nav>

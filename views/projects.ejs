<!--
  projects.ejs
  ---------------------------------------------------------------------------
  Renders the project overview page with recruiter-facing project cards.
  Desktop cards reveal stable, clickable overlays on hover/focus. On mobile,
  important information and actions stay visible without relying on hover.
-->

<main class="resume-layout">
  <%- include("partials/contactModal") %>

  <section class="projects-header">
    <h2>Projects</h2>
    <p>
      A focused selection of projects that show backend APIs, web apps, data
      work and browser-based game logic. Each project highlights what I built,
      practiced or helped stabilize.
    </p>
  </section>

  <section class="projects-grid" aria-label="Selected software projects">

    <!-- Featured Project: Board Game Intelligence API -->
    <article class="card project-card project-card-featured">
      <div class="project-card-body">
        <div class="project-header">
          <div class="project-card-topline">
            <span class="project-tag">Backend API</span>
            <span class="project-status">Live docs</span>
          </div>
          <h3 class="project-title">Board Game Intelligence API</h3>
          <p class="project-description">
            Backend-focused API for importing board game data, storing it in a
            structured PostgreSQL database and exposing documented endpoints for
            useful game recommendations.
          </p>
        </div>

        <div class="project-preview project-preview-api" aria-hidden="true">
          <span>FastAPI</span>
          <span>PostgreSQL</span>
          <span>Tests</span>
        </div>

        <p class="project-meta">
          <span class="project-tech-label">Tech:</span>
          <span class="project-tech-list">
            FastAPI, PostgreSQL, SQLAlchemy, Alembic, Docker, Pytest, Swagger/OpenAPI
          </span>
        </p>

        <div class="project-mobile-actions" aria-label="Board Game Intelligence API links">
          <a
            href="/projects/board-game-intelligence-api"
            class="project-link project-link-primary"
          >
            View Project
          </a>
          <a
            href="https://github.com/STU6266/board-game-intelligence-api"
            class="project-link project-link-secondary"
            target="_blank"
            rel="noopener"
          >
            GitHub
          </a>
          <a
            href="https://board-game-intelligence-api.onrender.com/docs"
            class="project-link project-link-secondary"
            target="_blank"
            rel="noopener"
          >
            API Docs
          </a>
        </div>
      </div>

      <div class="project-overlay">
        <div>
          <p class="project-overlay-label">Key Features</p>
          <ul class="project-feature-list">
            <li>External data import with validation and sync logic</li>
            <li>Relational database structure with migrations</li>
            <li>Service/repository style backend organization</li>
            <li>Automated tests and documented Swagger/OpenAPI endpoints</li>
          </ul>
        </div>
        <div class="project-overlay-actions">
          <a
            href="/projects/board-game-intelligence-api"
            class="project-link project-link-primary"
          >
            View Project
          </a>
          <a

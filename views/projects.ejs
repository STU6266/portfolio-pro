<!--
  projects.ejs
  ---------------------------------------------------------------------------
  Renders the project overview page with recruiter-facing project cards.
  Desktop cards reveal stable, clickable overlays on hover/focus. On mobile,
  important information and actions stay visible without relying on hover.
-->

<main class="resume-layout">
  <%- include("partials/contactModal") %>

  <section class="projects-header">
    <h2>Projects</h2>
    <p>
      A focused selection of projects that show backend APIs, web apps, data
      work and browser-based game logic. Each project highlights what I built,
      practiced or helped stabilize.
    </p>
  </section>

  <section class="projects-grid" aria-label="Selected software projects">

    <!-- Featured Project: FFKI Alpha -->
    <article class="card project-card project-card-featured">
      <div class="project-card-body">
        <div class="project-header">
          <div class="project-card-topline">
            <span class="project-tag">Private Alpha</span>
            <span class="project-status">Full-stack</span>
          </div>
          <h3 class="project-title">FFKI Alpha</h3>
          <p class="project-description">
            Controlled private alpha for a fantasy football web app built with
            Next.js, TypeScript, Prisma and PostgreSQL. It focuses on league,
            draft, roster, lineup, waivers, trades, scoring, playoffs, admin and
            audit foundations.
          </p>
        </div>

        <div class="project-preview project-preview-ffki" aria-hidden="true">
          <span>Next.js</span>
          <span>Prisma</span>
          <span>Alpha</span>
        </div>

        <p class="project-meta">
          <span class="project-tech-label">Tech:</span>
          <span class="project-tech-list">
            Next.js, TypeScript, PostgreSQL, Prisma, Neon, Render, Docker
          </span>
        </p>

        <div class="project-mobile-actions" aria-label="FFKI Alpha links">
          <a
            href="/projects/ffki-alpha"
            class="project-link project-link-primary"
          >
            View Project
          </a>
          <a
            href="https://ffki-alpha.onrender.com"
            class="project-link project-link-secondary"
            target="_blank"
            rel="noopener"
          >
            Live Demo
          </a>
        </div>
      </div>

      <div class="project-overlay">
        <div>
          <p class="project-overlay-label">Key Features</p>
          <ul class="project-feature-list">
            <li>Private alpha auth/session foundation with no public signup</li>
            <li>10-team league structure with human and AI manager foundations</li>
            <li>Snake draft, roster ownership and lineup slot foundations</li>
            <li>Waiver claims and trade flows with admin review/execution paths</li>
            <li>Scoring, matchups, standings and playoff bracket foundations</li>
            <li>Admin tools, audit/history logs and controlled demo team access</li>
            <li>Sleeper player metadata sync into the internal database</li>
          </ul>
        </div>
        <div class="project-overlay-actions">
          <a
            href="/projects/ffki-alpha"
            class="project-link project-link-primary"
          >
            View Project
          </a>
          <a
            href="https://ffki-alpha.onrender.com"
            class="project-link project-link-secondary"
            target="_blank"
            rel="noopener"
          >
            Live Demo
          </a>
        </div>
      </div>
    </article>

    <!-- Featured Project: Board Game Intelligence API -->
    <article class="card project-card project-card-featured">
